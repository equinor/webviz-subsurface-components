  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "engines": {
    "node": ">=14.17",
    "npm": ">=7"
  },
  "volta": {
    "node": "22.22.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
