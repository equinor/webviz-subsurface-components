{
  "name": "@webviz/wsc-common",
  "version": "2.0.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/webviz-subsurface-components.git",
    "directory": "typescript/packages/wsc-common"
  },
  "description": "Shared functionality for WebViz Subsurface Components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --project ./tsconfig.typecheck.json",
    "transpile": "tsc --project ./tsconfig.json",
    "build": "git clean -xdff dist && npm run transpile",
    "test_perf": "jest _performance",
    "test_correctness": "jest --coverage --testPathIgnorePatterns='_performance' --passWithNoTests",
    "test": "jest --coverage",
    "test:update": "npm test -- --u",
    "test:watch": "npm test -- --watch",
    "doc": "git clean -xdff docs && typedoc src"
  },
  "author": "Equinor <opensource@equinor.com>",
  "license": "MPL-2.0",
  "dependencies": {
    "@emerson-eps/color-tables": "^1.1.0",
    "ajv": "^8.18.0"
  },
  "peerDependencies": {
    "@deck.gl/core": "~9.3.2",
    "@mui/icons-material": "^5.11 || ^6 || ^7.3",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "volta": {
    "node": "22.22.0"
  }
}
